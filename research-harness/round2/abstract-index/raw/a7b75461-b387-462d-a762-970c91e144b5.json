rg/getProfileImage/xinxia/e3b14662-ab2b-45c7-b59b-1be281ea62c6/micro-avatar?1792875590000\" class=\"outputimage media-object thumbnail no-bottom-margin\"/></span><div class=\"media-body\"><h5 class=\"media-heading\">Xin Xia<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">Zhejiang University</span></h5><h5 class=\"media-heading\"><small>China</small></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/issta-2026/issta-2026-research-papers/29/SEER-Self-Enhancing-Chain-of-Thought-Compression-for-Reasoning-Models\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-a7b75461-b387-462d-a762-970c91e144b5').modal({ backdrop: 'static', keyboard: true}, 'show');" },
