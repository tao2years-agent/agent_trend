etDefaultImage/micro-avatar?1783985080000\" class=\"outputimage media-object thumbnail no-bottom-margin\"/></span><div class=\"media-body\"><h5 class=\"media-heading\">Shanping Li<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">Zhejiang University</span></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/ase-2025/ase-2025-papers/118/When-AllClose-Fails-Round-Off-Error-Estimation-for-Deep-Learning-Programs\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-8c1a80a8-05e0-42c0-9a3a-f3d42de12094').modal({ backdrop: 'static', keyboard: true}, 'show');" },
