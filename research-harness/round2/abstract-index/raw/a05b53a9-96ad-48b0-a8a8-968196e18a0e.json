pan><div class=\"media-body\"><h5 class=\"media-heading\">Baowen Xu<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">Nanjing University</span></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/issta-2026/issta-2026-research-papers/114/Fuzzing-the-Boundary-Between-Models-and-Code-in-Hybrid-AI-enabled-Systems\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-a05b53a9-96ad-48b0-a8a8-968196e18a0e').modal({ backdrop: 'static', keyboard: true}, 'show');" },
