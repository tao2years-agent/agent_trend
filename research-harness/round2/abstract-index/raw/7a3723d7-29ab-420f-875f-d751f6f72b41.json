il no-bottom-margin\"/></span><div class=\"media-body\"><h5 class=\"media-heading\">Zibin Zheng<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">Sun Yat-sen University</span></h5><h5 class=\"media-heading\"><small>China</small></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/icse-2026/icse-2026-research-track/182/What-to-Retrieve-for-Effective-Retrieval-Augmented-Code-Generation-An-Empirical-Stud\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-7a3723d7-29ab-420f-875f-d751f6f72b41').modal({ backdrop: 'static', keyboard: true}, 'show');" },
