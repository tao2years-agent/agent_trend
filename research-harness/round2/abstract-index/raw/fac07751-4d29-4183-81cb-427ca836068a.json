il no-bottom-margin\"/></span><div class=\"media-body\"><h5 class=\"media-heading\">Toufique Ahmed<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">IBM Research</span></h5><h5 class=\"media-heading\"><small>United States</small></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/icse-2025/icse-2025-research-track/8/Calibration-and-Correctness-of-Language-Models-for-Code\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-fac07751-4d29-4183-81cb-427ca836068a').modal({ backdrop: 'static', keyboard: true}, 'show');" },
