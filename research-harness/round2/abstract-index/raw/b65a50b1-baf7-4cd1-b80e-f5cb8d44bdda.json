ng1/ccdc743e-af18-4d02-ad1e-ea4f153d601c/micro-avatar?1793538917000\" class=\"outputimage media-object thumbnail no-bottom-margin\"/></span><div class=\"media-body\"><h5 class=\"media-heading\">Zibin Zheng<span class=\"pull-right\"><small></small></span></h5><h5 class=\"media-heading\"><span class=\"text-black\">Sun Yat-sen University</span></h5><h5 class=\"media-heading\"><small>China</small></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/ase-2026/ase-2026-research-track/189/Panorama-Unveiling-Latent-Dependencies-for-Microservice-Autoscaling-via-Meta-learnin\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-b65a50b1-baf7-4cd1-b80e-f5cb8d44bdda').modal({ backdrop: 'static', keyboard: true}, 'show');" },
