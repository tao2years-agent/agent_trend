><h5 class=\"media-heading\"><span class=\"text-black\">University of Melbourne</span></h5><h5 class=\"media-heading\"><small>Australia</small></h5></div></div></a></div></div></div><br></div><div class=\"modal-footer\"><span class=\"pull-left\"><a href=\"https://conf.researchr.org/details/icse-2026/icse-2026-research-track/185/Unlocking-LLM-Repair-Capabilities-Through-Cross-Language-Translation-and-Multi-Agent-\" target=\"_blank\" class=\"btn btn-default navigate\"><span class=\"glyphicon glyphicon-new-window\"></span> All Details</a></span><a href=\"#\" data-dismiss=\"modal\" class=\"btn btn-default\"><span class=\"glyphicon glyphicon-remove\"></span> Close</a></div></div></div></div>"},{ "action": "runscript", "value": "$('#modal-1b552822-6e30-443d-90d8-af556f8cdd4c').modal({ backdrop: 'static', keyboard: true}, 'show');" },
