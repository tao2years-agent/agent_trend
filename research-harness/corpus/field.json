  {
    "id": "I08",
    "title": "METR 随机任务试验",
    "location": "PDF pp.1–2、6–8",
    "fact": "16 位熟悉所维护项目的开源开发者做 246 个任务，任务被随机分配允许或禁止当时的 AI 工具。允许 AI 的实现用时估计增加 19%，作者给出的区间为 2%–39%。",
    "boundary": "研究覆盖 2025 年初的工具与熟悉仓库的开发者，不能把结论外推为 2026 年企业 agent 的效果。",
    "sources": [
      {
        "entity": "I08",
        "url": "https://metr.org/Early_2025_AI_Experienced_OS_Devs_Study-paper.pdf",
        "path": "raw/2026-11-20/I08.pdf",
        "detail": "PDF pp.1–2、6–8",
        "date": "",
        "sha256": "b6d4a8e7d8aeed20cc9a4545e485fdc5496b5cc48470338d2d7662b1953e5765"
      }
    ]
