  <entry>
    <id>tag:github.com,2008:Repository/846698999/v1.58.0</id>
    <updated>2026-11-09T19:17:23Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/aaif-goose/goose/releases/tag/v1.58.0"/>
    <title>v1.58.0</title>
    <content type="html">&lt;h2&gt;✨ Features&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Opt-in context relevance operation &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12589&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12589/hovercard&quot;&gt;#12589&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Context window report and viewer &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/10462&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/10462/hovercard&quot;&gt;#10462&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;AIHubMix declarative provider &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12997&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12997/hovercard&quot;&gt;#12997&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;RouterPlex declarative provider &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13068&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13068/hovercard&quot;&gt;#13068&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Lemonade provider &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12920&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12920/hovercard&quot;&gt;#12920&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Collapse thinking by default with a setting to control it (desktop) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12660&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12660/hovercard&quot;&gt;#12660&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;🐛 Bug Fixes&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Replace retired Spark X2 with Spark X2.5 in iflytek_astron &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12772&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12772/hovercard&quot;&gt;#12772&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Show current session ID in /status &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12607&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12607/hovercard&quot;&gt;#12607&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Keep session load on its replay fast path when stopped (desktop) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13190&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13190/hovercard&quot;&gt;#13190&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Replay OpenAI Responses reasoning across tool turns &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13222&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13222/hovercard&quot;&gt;#13222&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Route bare OpenAI GPT IDs to Mantle by ID shape (bedrock) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13211&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13211/hovercard&quot;&gt;#13211&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use supports_vision from /model/info (litellm) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13239&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13239/hovercard&quot;&gt;#13239&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Honor Retry-After on 429s mapped outside handle_status &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12986&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12986/hovercard&quot;&gt;#12986&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Classify typed context_length_exceeded errors as context overflow (openrouter) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13154&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13154/hovercard&quot;&gt;#13154&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Report failed manual compaction as an error (acp) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13099&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13099/hovercard&quot;&gt;#13099&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Fall back to default inference for Bedrock provider models without document block support &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12932&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12932/hovercard&quot;&gt;#12932&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Bump zstd to 0.14.3 for RUSTSEC advisories &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13162&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13162/hovercard&quot;&gt;#13162&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Restore Linux window icons (desktop) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13120&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13120/hovercard&quot;&gt;#13120&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Resolve variant suffixes like :free and :nitro to the base model (openrouter) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12979&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12979/hovercard&quot;&gt;#12979&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use catalog_provider_id for vision lookup on custom providers &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12993&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12993/hovercard&quot;&gt;#12993&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Start the agent only once after a fork (desktop) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13139&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13139/hovercard&quot;&gt;#13139&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove jsonwebtoken to avoid ignoring its cargo-deny advisories &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13141&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13141/hovercard&quot;&gt;#13141&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use recipe settings in scheduled runs (scheduler) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13138&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13138/hovercard&quot;&gt;#13138&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use system trust for WebSockets (voice) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13075&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13075/hovercard&quot;&gt;#13075&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Stop telling the model a screenshot tool exists (computercontroller) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13279&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13279/hovercard&quot;&gt;#13279&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;🔧 Improvements&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Replace Agent and AgentManager with one StateMachineServices per process &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12880&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12880/hovercard&quot;&gt;#12880&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Drop tool-specific tool call titles (desktop) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13107&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13107/hovercard&quot;&gt;#13107&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove ACP client-delegated developer tools &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13144&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13144/hovercard&quot;&gt;#13144&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;📚 Documentation&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Say that code is not the only way to contribute &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13292&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13292/hovercard&quot;&gt;#13292&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Feature GDK on the main website &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13245&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13245/hovercard&quot;&gt;#13245&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Give GDK its own navigation and developer guides &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13165&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13165/hovercard&quot;&gt;#13165&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Fikra API example for custom OpenAI endpoints &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13008&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13008/hovercard&quot;&gt;#13008&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</content>
