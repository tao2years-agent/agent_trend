  <entry>
    <id>tag:github.com,2008:Repository/846698999/v1.59.0</id>
    <updated>2026-11-10T17:27:36Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/aaif-goose/goose/releases/tag/v1.59.0"/>
    <title>v1.59.0</title>
    <content type="html">&lt;h2&gt;✨ Features&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Minimal deferred MCP tools in ToolExecutionOperation &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13378&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13378/hovercard&quot;&gt;#13378&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Configurable and per-start voice instructions for live-voice &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13375&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13375/hovercard&quot;&gt;#13375&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Configurable GPT-Live endpoint, model and key &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13360&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13360/hovercard&quot;&gt;#13360&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Filter session/list by client tags (ACP) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13173&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13173/hovercard&quot;&gt;#13173&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Stop, approval, and tool hook operations for goose-agent (GDK) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13169&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13169/hovercard&quot;&gt;#13169&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Resume completed delegates with a follow-up (subagent) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13106&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13106/hovercard&quot;&gt;#13106&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;🐛 Bug Fixes&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Honor HTTP(S) docs roots in goose-doc-guide &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13381&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13381/hovercard&quot;&gt;#13381&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use uncorrelated IN for session keyword search &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13373&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13373/hovercard&quot;&gt;#13373&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Isolate session database initialization from application pool &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13324&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13324/hovercard&quot;&gt;#13324&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Refresh Databricks OAuth tokens before they expire &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13328&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13328/hovercard&quot;&gt;#13328&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Reword compaction prompt that Opus 5.5 refuses as distillation &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13340&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13340/hovercard&quot;&gt;#13340&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Send Gemini thinking level and drop stream_options for Databricks &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13232&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13232/hovercard&quot;&gt;#13232&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Address new cargo-deny advisories (zip8) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13309&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13309/hovercard&quot;&gt;#13309&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;📚 Documentation&lt;/h2&gt;
