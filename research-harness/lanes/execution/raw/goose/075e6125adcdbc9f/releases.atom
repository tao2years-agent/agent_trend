    <id>tag:github.com,2008:Repository/846698999/v1.60.0</id>
    <updated>2026-11-17T23:40:50Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/aaif-goose/goose/releases/tag/v1.60.0"/>
    <title>v1.60.0</title>
    <content type="html">&lt;h2&gt;✨ Features&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;SkillOperation and drop the Skills extension &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13574&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13574/hovercard&quot;&gt;#13574&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Executable commands and SlashCommandOperation in oi-kit &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13533&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13533/hovercard&quot;&gt;#13533&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Bang command operation in oi-kit &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13535&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13535/hovercard&quot;&gt;#13535&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Steering operation in oi-kit &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13502&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13502/hovercard&quot;&gt;#13502&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Dutch (nl) translation &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13240&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13240/hovercard&quot;&gt;#13240&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Cortecs declarative provider &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12617&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12617/hovercard&quot;&gt;#12617&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Onysoft declarative provider &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13582&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13582/hovercard&quot;&gt;#13582&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Reusable turn limits in GDK &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13194&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13194/hovercard&quot;&gt;#13194&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;🐛 Bug Fixes&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Restore AGENT and GOOSE_TERMINAL in developer shell &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13598&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13598/hovercard&quot;&gt;#13598&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Validate cron before changing existing schedules &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13599&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13599/hovercard&quot;&gt;#13599&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Keep think tags in Ollama XML tool-call arguments &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13563&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13563/hovercard&quot;&gt;#13563&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Send tool_choice auto when tools are present (OpenAI) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12716&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12716/hovercard&quot;&gt;#12716&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Update missing and outdated zh-CN translations &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13494&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13494/hovercard&quot;&gt;#13494&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Load supporting files for skills under symlinked directories &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13531&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13531/hovercard&quot;&gt;#13531&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Bound empty response retries in oi-kit &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13516&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13516/hovercard&quot;&gt;#13516&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Drop thinking blocks bound to a different prefix (Databricks) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13551&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13551/hovercard&quot;&gt;#13551&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Handle a closed stdout pipe when exporting a session &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13385&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13385/hovercard&quot;&gt;#13385&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Build llama.cpp without OpenSSL so goose builds with openssl 4 &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13492&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13492/hovercard&quot;&gt;#13492&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Keep request logs private on Unix &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13253&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13253/hovercard&quot;&gt;#13253&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Keep goose temporary directories private on shared systems &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12868&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12868/hovercard&quot;&gt;#12868&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Do not retry 400s that reject the thinking setting &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13325&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13325/hovercard&quot;&gt;#13325&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Send adaptive thinking to MiniMax-M3.1-Flash &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13305&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13305/hovercard&quot;&gt;#13305&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Exclude native libraries from Kotlin sources jar &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13446&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13446/hovercard&quot;&gt;#13446&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Give Gemini tool calls unique ids (Databricks) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13483&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13483/hovercard&quot;&gt;#13483&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use adaptive thinking for Claude Fable 5.2 (Anthropic) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13478&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13478/hovercard&quot;&gt;#13478&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Report auto-compaction pending at the capped threshold &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13476&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13476/hovercard&quot;&gt;#13476&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Store token counts as i64 &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13422&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13422/hovercard&quot;&gt;#13422&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Refresh Vercel AI Gateway models from the API &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13442&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13442/hovercard&quot;&gt;#13442&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Finish Windows ZIP updates after the app quits &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13423&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13423/hovercard&quot;&gt;#13423&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Make final_output visible only to the model &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13382&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13382/hovercard&quot;&gt;#13382&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Surface stream errors and premature completion &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13226&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13226/hovercard&quot;&gt;#13226&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Enable tokio rt for mcp example under --all-targets &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13346&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13346/hovercard&quot;&gt;#13346&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Omit repeated advertised_tools from persisted metadata &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13359&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13359/hovercard&quot;&gt;#13359&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Report Bedrock truncation with streaming disabled &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13266&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13266/hovercard&quot;&gt;#13266&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Preserve tool-image batch ordering in persisted transcripts &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13294&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13294/hovercard&quot;&gt;#13294&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;🔧 Improvements&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Separate platform extensions from the MCP runtime &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13568&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13568/hovercard&quot;&gt;#13568&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Fire tool hooks from goose&#39;s own run loop &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13566&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13566/hovercard&quot;&gt;#13566&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove chat mode &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13571&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13571/hovercard&quot;&gt;#13571&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Move ExitOnErrorOperation to oi-kit &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13500&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13500/hovercard&quot;&gt;#13500&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove hook APIs from the GDK and fire hooks directly in Goose &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13486&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13486/hovercard&quot;&gt;#13486&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Prepare Goose extension configs and shared MCP types for GDK extraction &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13467&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13467/hovercard&quot;&gt;#13467&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Bump Electron to 45.2.3 and raise the macOS minimum to 13 &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13455&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13455/hovercard&quot;&gt;#13455&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Register status with state machine operations &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13436&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13436/hovercard&quot;&gt;#13436&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Declare form elicitation capability explicitly (MCP) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13428&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13428/hovercard&quot;&gt;#13428&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove the goose review subcommand &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13469&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13469/hovercard&quot;&gt;#13469&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Raise MSRV to 1.95.0 for rustyline 19 &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13597&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13597/hovercard&quot;&gt;#13597&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Publish lean goose-acp as soon as it is built &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13562&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13562/hovercard&quot;&gt;#13562&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;📚 Documentation&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Update the EmpirioLabs AI provider (retired model id, description, catalog link) &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13229&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13229/hovercard&quot;&gt;#13229&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Fix stale agent entry point in AGENTS.md &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13539&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13539/hovercard&quot;&gt;#13539&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Document the Windows installer for goose Desktop &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/12942&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/12942/hovercard&quot;&gt;#12942&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Update grants page for Spiral administration &lt;a href=&quot;https://github.com/aaif-goose/goose/pull/13418&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/aaif-goose/goose/pull/13418/hovercard&quot;&gt;#13418&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</content>
