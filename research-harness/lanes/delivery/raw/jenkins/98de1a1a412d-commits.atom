    <title>
        Assert dialog title trims boundary whitespace
    </title>
    <updated>2026-11-06T23:06:12Z</updated>
    <media:thumbnail height="30" width="30" url="https://avatars.githubusercontent.com/u/21194782?s=30&amp;v=4"/>
