&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;cli:&lt;/strong&gt; add prompt tag command (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17759&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17759/hovercard&quot;&gt;#17759&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/5160fd586e1ad247ed131c12aa8b7bd168037e45&quot;&gt;5160fd5&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;evaluators:&lt;/strong&gt; run LLM evaluators on Anthropic prompts with extended thinking (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17734&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17734/hovercard&quot;&gt;#17734&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/593a776b28da6eb329051f28fdba8f6e2559ae47&quot;&gt;593a776&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;factory:&lt;/strong&gt; pin commits and screen inputs before agent sessions (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17811&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17811/hovercard&quot;&gt;#17811&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/7d3a2450feec8f6b71ab21220b2c41c62bc05207&quot;&gt;7d3a245&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;factory:&lt;/strong&gt; send a user agent Railway accepts from the preview deploy script (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18007&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18007/hovercard&quot;&gt;#18007&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/a94d1297f99d42473e19cefe28732d53e11c2c82&quot;&gt;a94d129&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;factory:&lt;/strong&gt; stop mentioning the requester in factory comments (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18012&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18012/hovercard&quot;&gt;#18012&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/9f9ee7de153e43064d8ae1a530139b6191338bc4&quot;&gt;9f9ee7d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;notebooks:&lt;/strong&gt; deprecate legacy eval benchmark notebooks (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17981&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17981/hovercard&quot;&gt;#17981&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/9c80b636b4d127a54e7dd347f62c2059b87a5efc&quot;&gt;9c80b63&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;server:&lt;/strong&gt; delete retention traces in batches that skip locked rows (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18021&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18021/hovercard&quot;&gt;#18021&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/364d93e3b3792492659e8526a0f848209e2fb9bf&quot;&gt;364d93e&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
