    <id>tag:github.com,2008:Repository/564072810/arize-phoenix-v21.3.0</id>
    <updated>2026-11-20T02:57:03Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/Arize-ai/phoenix/releases/tag/arize-phoenix-v21.3.0"/>
    <title>arize-phoenix: v21.3.0</title>
    <content type="html">&lt;h2&gt;&lt;a href=&quot;https://github.com/Arize-ai/phoenix/compare/arize-phoenix-v21.2.1...arize-phoenix-v21.3.0&quot;&gt;21.3.0&lt;/a&gt; (2026-11-20)&lt;/h2&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;brand:&lt;/strong&gt; set the Arize Phoenix wordmark in Geist (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18086&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18086/hovercard&quot;&gt;#18086&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/b1763711d88ac3767b710e92e1f61bede61e3f45&quot;&gt;b176371&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;cli:&lt;/strong&gt; add dataset label assignment commands (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17973&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17973/hovercard&quot;&gt;#17973&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/0b821b2ff030b4cf90e88096fee35f4363e3671a&quot;&gt;0b821b2&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;pxi:&lt;/strong&gt; refresh recommended models and preserve chat transcripts (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18101&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18101/hovercard&quot;&gt;#18101&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/4270bcecd2b488691f871c877b8ec18d51acff1b&quot;&gt;4270bce&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;build:&lt;/strong&gt; let the publish wheel check allow duplicate skill files (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18076&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18076/hovercard&quot;&gt;#18076&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/9670b20cb9ed2e73e0941c195b793a99ef25fb0c&quot;&gt;9670b20&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;cost:&lt;/strong&gt; update built-in model token prices (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17762&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17762/hovercard&quot;&gt;#17762&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/74c52b3013aaf22f9fcde4de1eeba23ad5c78eaf&quot;&gt;74c52b3&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;pxi:&lt;/strong&gt; keep view filters out of analytics SQL and narrow experiments skill trigger (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/17730&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/17730/hovercard&quot;&gt;#17730&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/3df033a6637b5460d6bf7c1f6537ed6567472e2b&quot;&gt;3df033a&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;server:&lt;/strong&gt; price Bedrock regional Claude ids at Bedrock&#39;s rate (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18052&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18052/hovercard&quot;&gt;#18052&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/e792adcaed53e8ddfe3300ff5286a00f2ecb1fe2&quot;&gt;e792adc&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;server:&lt;/strong&gt; trim PHOENIX_CSRF_TRUSTED_ORIGINS entries before validation (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/7183c9813cec7c31aa16d226db2d59b40c45df9b&quot;&gt;7183c98&lt;/a&gt;), closes &lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18100&quot; data-hovercard-type=&quot;issue&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/issues/18100/hovercard&quot;&gt;#18100&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Performance Improvements&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;traces:&lt;/strong&gt; read a project&#39;s newest root spans from its own traces (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18120&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18120/hovercard&quot;&gt;#18120&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/77e5e3b8682d0a328717f99be24cf5b1d7165b2c&quot;&gt;77e5e3b&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Documentation&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;remove Slack community links from READMEs (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18109&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18109/hovercard&quot;&gt;#18109&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/02ed1808d9fb82263e85479e6ae80310883fcc2b&quot;&gt;02ed180&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;skills:&lt;/strong&gt; add phoenix-social skill for grounded social posts staged in Typefully (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18078&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18078/hovercard&quot;&gt;#18078&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/465be9a24d40bae1108d80356f69d087bbc51c5c&quot;&gt;465be9a&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;skills:&lt;/strong&gt; weekly audit — 2026-11-18 (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/issues/18043&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/Arize-ai/phoenix/pull/18043/hovercard&quot;&gt;#18043&lt;/a&gt;) (&lt;a href=&quot;https://github.com/Arize-ai/phoenix/commit/9649308f9e88de1e111b1b0a4a8fa4104897d55a&quot;&gt;9649308&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
